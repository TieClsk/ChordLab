{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChordLab",
  "version": "0.0.1",
  "identifier": "app.chordlab.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @chordlab/web dev",
    "beforeBuildCommand": "pnpm --filter @chordlab/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ChordLab",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "ChordLab — chord learning & songwriting",
    "category": "Music"
  }
}
